<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DiamondGameActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            android:background="#EFD4D4"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Point : 200"
                android:textSize="10pt"
                android:layout_centerHorizontal="true"
                android:id="@+id/tvDiamondPoint"
                android:layout_marginTop="50dp"
                />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checkout"
                android:layout_centerHorizontal="true"
                android:id="@+id/btnDiamondCheckout"
                android:layout_below="@id/tvDiamondPoint"
                android:layout_marginTop="20dp"
                android:visibility="invisible"
                 />


        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
           android:layout_weight="2"
            >

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1"
                android:id="@+id/imgBtnDiamondB1"
                />

            <ImageButton
                android:layout_width="0dp"
                android:id="@+id/imgBtnDiamondB2"

                android:layout_height="match_parent" android:layout_weight="1"/>
            <ImageButton
                android:layout_width="0dp"
                android:id="@+id/imgBtnDiamondB3"

                android:layout_height="match_parent" android:layout_weight="1"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            >

            <ImageButton
                android:layout_width="0dp"
                android:id="@+id/imgBtnDiamondB4"

                android:layout_height="match_parent" android:layout_weight="1"/>

            <ImageButton
                android:layout_width="0dp"
                android:id="@+id/imgBtnDiamondB5"


                android:layout_height="match_parent" android:layout_weight="1"/>
            <ImageButton
                android:layout_width="0dp"
                android:id="@+id/imgBtnDiamondB6"

                android:layout_height="match_parent" android:layout_weight="1"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            >

            <ImageButton
                android:layout_width="0dp"
                android:id="@+id/imgBtnDiamondB7"

                android:layout_height="match_parent" android:layout_weight="1"/>

            <ImageButton
                android:layout_width="0dp"
                android:id="@+id/imgBtnDiamondB8"

                android:layout_height="match_parent" android:layout_weight="1"/>
            <ImageButton
                android:layout_width="0dp"
                android:id="@+id/imgBtnDiamondB9"
                android:layout_height="match_parent" android:layout_weight="1"/>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>